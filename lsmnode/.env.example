# Порт агента
PORT=9000

# Общий секрет с LSM-мастером (должен совпадать со значением в панели)
SHARED_SECRET=

# Провайдер, которым управляет эта нода: xui | naive
PROVIDER=xui

# --- PROVIDER=xui -------------------------------------------------------------
XUI_HOST=http://127.0.0.1:2053
XUI_USER=
XUI_PASSWORD=

# --- PROVIDER=naive -----------------------------------------------------------
# Файл с управляемыми basic_auth-строками, который импортит основной Caddyfile.
# ВАЖНО: статическая строка basic_auth в самом Caddyfile должна остаться —
# forward_proxy без единого basic_auth стал бы открытым прокси.
CADDY_USERS_FILE=/home/hosfop/naive/naive-users.caddy
# Имя docker-контейнера с Caddy (для `docker exec ... caddy reload`)
CADDY_CONTAINER=naive
