# Порт, на котором слушает lsm-node
PORT=9000

# Секретный токен для авторизации запросов от LSM-мастера
# Должен совпадать с тем, что прописан в настройках ноды в LSM
SHARED_SECRET=changeme

# Адрес 3x-ui панели (обычно localhost, т.к. lsm-node работает на том же хосте)
XUI_HOST=http://127.0.0.1:2053

# Логин и пароль от 3x-ui панели
XUI_USER=admin
XUI_PASSWORD=changeme
